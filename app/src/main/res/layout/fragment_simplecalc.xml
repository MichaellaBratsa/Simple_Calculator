<?xml version="1.0" encoding="utf-8"?>

<!--
    This is the layout for a simple calculator app (Portrait mode).
    Key points:
    1. The root layout is a LinearLayout with vertical orientation, so elements stack top to bottom.
    2. Padding is applied to give space around the edges.
    3. The first child is a TextView (tv_display) that shows the current expression or result.
       - Gravity is set to "end" so numbers align to the right like a standard calculator.
       - Initial text is "0" and it has a dark background for visibility.
    4. Below the display is a GridLayout that contains all the calculator buttons.
       - 4 columns are defined for a standard calculator layout.
       - Margin between buttons is set for spacing.
       - Button backgrounds are customized with modern dark theme colors.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1E1E1E">

    <!-- Display area: shows the current number or result -->
    <TextView
        android:id="@+id/tv_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="end|bottom"
        android:text="0"
        android:textSize="36sp"
        android:textColor="#FFFFFF"
        android:padding="16dp"
        android:background="#2C2C2C"
        android:fontFamily="sans-serif-light"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Button grid: contains all calculator buttons in 4 columns -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:layout_marginTop="12dp"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="false">

        <!-- Row 1: C ( ) DEL -->


        <Button android:id="@+id/btn_log"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="LOG"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#505050"/>

        <Button android:id="@+id/btn_sqrt"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="√x"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#505050"/>

        <Button android:id="@+id/btn_pow"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="x^y"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#505050"/>

        <!-- Row 7: abs fact % GCD -->
        <Button android:id="@+id/btn_abs"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="|x|"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#505050"/>

        <Button android:id="@+id/btn_fact"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="x!"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#505050"/>

        <Button android:id="@+id/btn_percentage"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="%"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#505050"/>

        <Button android:id="@+id/btn_gcd"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="GCD"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#505050"/>

        <!-- Row 8: LCM (single button, spans remaining space) -->
        <Button android:id="@+id/btn_lcm"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="LCM"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#505050"/>

        <!-- Row 2: 7 8 9 + -->

        <Button android:id="@+id/btn_open"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="("
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#505050"/>

        <Button android:id="@+id/btn_close"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text=")"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#505050"/>

        <Button android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="C"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9500"/>

        <Button android:id="@+id/btn_del"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="DEL"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9500"/>

        <Button android:id="@+id/btn_7"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="7"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <Button android:id="@+id/btn_8"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="8"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <Button android:id="@+id/btn_9"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="9"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <Button android:id="@+id/btn_add"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="+"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9500"/>

        <!-- Row 3: 4 5 6 - -->
        <Button android:id="@+id/btn_4"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="4"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <Button android:id="@+id/btn_5"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="5"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <Button android:id="@+id/btn_6"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="6"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <Button android:id="@+id/btn_sub"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="−"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9500"/>

        <!-- Row 4: 1 2 3 = -->
        <Button android:id="@+id/btn_1"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="1"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <Button android:id="@+id/btn_2"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="2"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <Button android:id="@+id/btn_3"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="3"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <Button android:id="@+id/btn_mul"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="×"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9500"/>

        <Button android:id="@+id/btn_dot"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="."
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <Button android:id="@+id/btn_0"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="0"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <Button android:id="@+id/btn_com"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text=","
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"/>

        <!-- Row 6: / log sqrt pow -->
        <Button android:id="@+id/btn_div"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="÷"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9500"/>

        <Button android:id="@+id/btn_equal"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_columnSpan="4"
            android:layout_margin="3dp"
            android:text="="
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#34C759"/>
    </GridLayout>
</LinearLayout>