<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Row 1: HW1 and HW2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/HW1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="Homework 1:"
                android:inputType="numberDecimal"
                android:padding="10dp" />

            <EditText
                android:id="@+id/HW2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:hint="Homework 2:"
                android:inputType="numberDecimal"
                android:padding="10dp" />
        </LinearLayout>

        <!-- Row 2: HW3 and HW4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/HW3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="Homework 3:"
                android:inputType="numberDecimal"
                android:padding="10dp" />

            <EditText
                android:id="@+id/HW4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:hint="Homework 4:"
                android:inputType="numberDecimal"
                android:padding="10dp" />
        </LinearLayout>

        <!-- Row 3: Team Project and Midterm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/teamProject"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="Team Project:"
                android:inputType="numberDecimal"
                android:padding="10dp" />

            <EditText
                android:id="@+id/midTerm"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:hint="Midterm Exam:"
                android:inputType="numberDecimal"
                android:padding="10dp" />
        </LinearLayout>

        <!-- Row 4: Final Exam and Class Participation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/finalExam"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="Final Exam:"
                android:inputType="numberDecimal"
                android:padding="10dp" />

            <EditText
                android:id="@+id/classParticipation"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:hint="Class Participation:"
                android:inputType="numberDecimal"
                android:padding="10dp" />
        </LinearLayout>

        <!-- Button and Result -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/calcButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Calculate"
                android:paddingHorizontal="24dp" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Final Semester Grade at CS498: "
                android:textSize="16sp"
                android:padding="10dp"
                android:textColor="@android:color/black"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>